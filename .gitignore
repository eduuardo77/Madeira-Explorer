# Dependencies
node_modules/

# Expo
.expo/
dist/
web-build/
expo-env.d.ts

# Native projects are generated by `expo prebuild` (Continuous Native Generation).
# Do not commit them — regenerate instead. If you ever need to hand-edit native
# code, delete these lines and commit the folders deliberately.
app/ios/
app/android/

# Build artefacts
*.jks
*.p8
*.p12
*.key
*.mobileprovision
*.orig.*

# Generated tile packs. The *pipeline* is committed; its output is not —
# tens of MB, reproducible from the script (T-023).
tiles/out/
tiles/src/
*.pmtiles
# …except the packs the app ships: EAS Build uploads git-tracked files only,
# so the bundled map (D-036) must be committed. Regenerated by
# tiles/pipeline/build.sh + build-terrain.py, copied here by hand (docs/map-style.md).
!app/assets/map/*.pmtiles
*.mbtiles
*.osm.pbf

# Planetiler scratch: tile_weights.tsv.gz (5.7 MB global tile-load stats, used
# for weighted average tile size) and tmp/. Downloaded artefacts, not source.
data/

# Tile-build toolchain — fetched by tools/fetch-toolchain.sh, never committed.
# ~700 MB of third-party binaries. Portable: nothing is installed system-wide
# and nothing is on PATH, so deleting these two folders fully removes it.
tools/jdk/
tools/bin/

# OS noise
.DS_Store
Thumbs.db

# Local environment
.env
.env.local

# NOTE: tools/fixtures/ is deliberately NOT ignored.
# The Phase 0 field traces are the permanent matching regression suite (T-021).

# Portable Android emulator (tools/fetch-android-emulator.sh). ~2.5 GB,
# reproducible from the script, never committed.
tools/android-sdk/

# Emulator screenshots (tools/screenshot.sh). Throwaway and ~1.3 MB each; the
# deliberate artefacts in tools/out/ are committed individually instead.
tools/out/shots/
