# Copy to app/.env and paste your own key. Never commit the real one (D-057).
#
# Google Cloud console -> new project -> enable "Maps SDK for Android"
# -> Credentials -> create API key -> restrict it to:
#     * Android apps: package com.proa.madeira + your SHA-1 fingerprint
#     * API restriction: Maps SDK for Android only
#
# Map display on the mobile SDK is free and unlimited (SKU 6DE1-4D9C-5B67),
# but the Cloud project still needs a billing account attached.
#
# Without this the map renders as a grey grid. Everything else still works.
GOOGLE_MAPS_API_KEY=
