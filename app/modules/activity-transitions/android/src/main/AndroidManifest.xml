<manifest xmlns:android="http://schemas.android.com/apk/res/android">
  <!-- "Physical activity" (D-094). Asked at runtime on Android 10 and later. -->
  <uses-permission android:name="android.permission.ACTIVITY_RECOGNITION" />
  <!-- Android 9 and earlier: the Play services permission, granted at install. -->
  <uses-permission android:name="com.google.android.gms.permission.ACTIVITY_RECOGNITION" />
  <application>
    <receiver
      android:name="expo.modules.activitytransitions.ActivityTransitionReceiver"
      android:exported="false" />
  </application>
</manifest>
