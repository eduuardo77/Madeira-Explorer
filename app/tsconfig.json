{
  "extends": "expo/tsconfig.base",
  "compilerOptions": {
    "strict": true,
    // Lets a module say `./distance.ts` instead of `./distance`. Needed because
    // the pure modules are unit-tested by Node's own test runner, and Node's
    // module resolver — unlike Metro's — will not guess a missing extension.
    // Safe here because this project never emits JavaScript from tsc: Metro
    // does the building, tsc only type-checks (`noEmit` is set in the base).
    "allowImportingTsExtensions": true,
    // `node` is here for the unit tests only — they import `node:test`, which
    // the app itself never touches. `react` has to be listed alongside it
    // because naming anything in this field switches off the automatic
    // inclusion of everything else under `node_modules/@types`, and JSX would
    // stop type-checking without it.
    "types": ["node", "react"]
  },
  // ⚠ `attic/` is kept, not compiled (T-117d, D-057 amended). The MapLibre map
  // was replaced by the platform's and the project lead asked that it not be
  // deleted — so it lives there, in the repository, out of the build. Keeping
  // the *source* and shipping the *native library* are different things, and
  // only the second cost 10 MB of every install.
  "exclude": ["attic"]
}
