{
  "version": 8,
  "name": "Madeira light — spike",
  "metadata": {
    "madeira:purpose": "T-025 spike style. NOT the shipping style (T-058).",
    "madeira:schema": "Protomaps basemap (D-030). Layers: earth, landuse, water, roads, places, pois, boundaries, transit, buildings.",
    "madeira:notes": [
      "Hand-written and diagnostic on purpose: its job is to show what the pack",
      "contains with as few variables as possible. Levadas are drawn LOUD here",
      "so their presence is obvious - the opposite of what T-058 will do.",
      "The shipping style starts from a Protomaps theme and SUBTRACTS (D-026).",
      "No terrain: D-026 wants shaded relief and this pack has none yet. That,",
      "not the schema, is the biggest open question about how good this looks."
    ]
  },
  "glyphs": "https://fonts.openmaptiles.org/{fontstack}/{range}.pbf",
  "sources": {
    "madeira": {
      "type": "vector",
      "tiles": ["http://localhost:8080/madeira/{z}/{x}/{y}.mvt"],
      "minzoom": 0,
      "maxzoom": 15,
      "attribution": "<a href=\"https://www.openstreetmap.org/copyright\">&copy; OpenStreetMap contributors</a>"
    }
  },
  "layers": [
    { "id": "bg", "type": "background", "paint": { "background-color": "#c3d4dd" } },

    {
      "id": "earth",
      "type": "fill",
      "source": "madeira",
      "source-layer": "earth",
      "paint": { "fill-color": "#eae7e1" }
    },
    {
      "id": "landuse-green",
      "type": "fill",
      "source": "madeira",
      "source-layer": "landuse",
      "filter": ["match", ["get", "kind"],
        ["wood", "forest", "nature_reserve", "park", "scrub", "grassland", "meadow"], true, false],
      "paint": {
        "fill-color": ["match", ["get", "kind"],
          ["wood", "forest"], "#d3ddc6",
          ["scrub"], "#dde2cf",
          "#e0e6d6"],
        "fill-opacity": 0.85
      }
    },
    {
      "id": "landuse-rock",
      "type": "fill",
      "source": "madeira",
      "source-layer": "landuse",
      "filter": ["==", ["get", "kind"], "bare_rock"],
      "paint": { "fill-color": "#dedad2" }
    },
    {
      "id": "cliffs",
      "type": "line",
      "source": "madeira",
      "source-layer": "earth",
      "filter": ["==", ["get", "kind"], "cliff"],
      "paint": {
        "line-color": "#b3aca0",
        "line-width": ["interpolate", ["linear"], ["zoom"], 11, 0.4, 15, 1.4]
      }
    },
    {
      "id": "water",
      "type": "fill",
      "source": "madeira",
      "source-layer": "water",
      "paint": { "fill-color": "#c3d4dd" }
    },
    {
      "id": "water-lines",
      "type": "line",
      "source": "madeira",
      "source-layer": "water",
      "filter": ["match", ["get", "kind"], ["stream", "river"], true, false],
      "paint": {
        "line-color": "#a9c4d2",
        "line-width": ["interpolate", ["linear"], ["zoom"], 12, 0.4, 15, 1.4]
      }
    },

    {
      "id": "roads-minor",
      "type": "line",
      "source": "madeira",
      "source-layer": "roads",
      "filter": ["match", ["get", "kind"], ["minor_road", "other"], true, false],
      "paint": {
        "line-color": "#ffffff",
        "line-width": ["interpolate", ["linear"], ["zoom"], 11, 0.4, 16, 3]
      }
    },
    {
      "id": "roads-major",
      "type": "line",
      "source": "madeira",
      "source-layer": "roads",
      "filter": ["==", ["get", "kind"], "major_road"],
      "paint": {
        "line-color": "#ffffff",
        "line-width": ["interpolate", ["linear"], ["zoom"], 8, 0.8, 16, 7]
      }
    },
    {
      "id": "roads-tunnel",
      "type": "line",
      "source": "madeira",
      "source-layer": "roads",
      "filter": ["==", ["get", "is_tunnel"], true],
      "paint": {
        "line-color": "#b9b4ab",
        "line-dasharray": [2, 2],
        "line-width": ["interpolate", ["linear"], ["zoom"], 8, 0.8, 16, 5]
      }
    },
    {
      "id": "paths",
      "type": "line",
      "source": "madeira",
      "source-layer": "roads",
      "filter": ["==", ["get", "kind"], "path"],
      "paint": {
        "line-color": "#c9bfae",
        "line-dasharray": [3, 2],
        "line-width": ["interpolate", ["linear"], ["zoom"], 12, 0.6, 16, 2]
      }
    },

    {
      "id": "DIAGNOSTIC-levada-path",
      "type": "line",
      "source": "madeira",
      "source-layer": "roads",
      "filter": ["all",
        ["has", "name"],
        ["in", "evada", ["coalesce", ["get", "name"], ""]]
      ],
      "paint": {
        "line-color": "#e01b6a",
        "line-width": ["interpolate", ["linear"], ["zoom"], 12, 2, 16, 6]
      }
    },
    {
      "id": "DIAGNOSTIC-levada-channel",
      "type": "line",
      "source": "madeira",
      "source-layer": "water",
      "filter": ["all",
        ["has", "name"],
        ["in", "evada", ["coalesce", ["get", "name"], ""]]
      ],
      "paint": {
        "line-color": "#ff8c00",
        "line-width": ["interpolate", ["linear"], ["zoom"], 12, 1.5, 16, 4]
      }
    },

    {
      "id": "place-labels",
      "type": "symbol",
      "source": "madeira",
      "source-layer": "places",
      "layout": {
        "text-field": ["coalesce", ["get", "name:en"], ["get", "name"]],
        "text-font": ["Noto Sans Regular"],
        "text-size": ["interpolate", ["linear"], ["zoom"], 8, 11, 14, 15],
        "text-max-width": 8
      },
      "paint": {
        "text-color": "#3c3833",
        "text-halo-color": "#eae7e1",
        "text-halo-width": 1.4
      }
    },
    {
      "id": "peak-labels",
      "type": "symbol",
      "source": "madeira",
      "source-layer": "pois",
      "minzoom": 11,
      "filter": ["==", ["get", "kind"], "peak"],
      "layout": {
        "text-field": ["concat",
          ["coalesce", ["get", "name"], ""], " ",
          ["to-string", ["coalesce", ["get", "elevation"], ""]], "m"],
        "text-font": ["Noto Sans Regular"],
        "text-size": 10
      },
      "paint": {
        "text-color": "#6b6257",
        "text-halo-color": "#eae7e1",
        "text-halo-width": 1.2
      }
    }
  ]
}
